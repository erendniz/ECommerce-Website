@model List<API.Models.Cart>

<style>
	body {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		background-color: #f8f8f8;
		color: #333333;
		margin: 0;
		padding: 10px 20px;
	}

	a {
		color: #0000cc;
		text-decoration: underline;
	}

		a:hover {
			color: #3366cc;
		}

	.web-top-bar {
		background: linear-gradient(to bottom, #ffffff 0%, #eef0f2 100%);
		border: 1px solid #cccccc;
		border-radius: 4px;
		padding: 8px 15px;
		margin-bottom: 15px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.web-btn-default {
		background: linear-gradient(to bottom, #fefefe 0%, #e0e0e0 100%);
		border: 1px solid #a0a0a0;
		border-radius: 3px;
		padding: 4px 12px;
		font-size: 11px;
		font-weight: bold;
		color: #333;
		cursor: pointer;
		box-shadow: inset 0 1px 0 #fff;
	}

		.web-btn-default:hover {
			background: linear-gradient(to bottom, #f0f0f0 0%, #d0d0d0 100%);
		}

	.web-alert {
		background-color: #fff6bf;
		border: 1px solid #ffd23f;
		padding: 8px 12px;
		margin-bottom: 12px;
		font-weight: bold;
		color: #514721;
	}

	.web-module {
		border: 1px solid #c8c8c8;
		background-color: #ffffff;
		margin-bottom: 20px;
	}

	.web-module-header {
		background: linear-gradient(to bottom, #e8edf6 0%, #d2dceb 100%);
		border-bottom: 1px solid #b2c2d6;
		padding: 8px 12px;
		font-weight: bold;
		font-size: 14px;
		color: #003366;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.web-module-body {
		padding: 10px;
	}

	.web-table {
		width: 100%;
		border-collapse: collapse;
		background-color: #ffffff;
		border: 1px solid #cccccc;
	}

		.web-table th {
			background: linear-gradient(to bottom, #e8edf6 0%, #d2dceb 100%);
			border: 1px solid #b2c2d6;
			padding: 8px 5px;
			font-size: 11px;
			color: #003366;
			text-align: center;
		}

		.web-table td {
			border: 1px solid #e0e0e0;
			padding: 8px 5px;
			vertical-align: middle;
		}

		.web-table tr:nth-child(even) {
			background-color: #f9f9f9;
		}

		.web-table tr:hover {
			background-color: #f0f4f9;
		}

	.web-price-text {
		font-size: 13px;
		font-weight: bold;
		color: #b20000;
	}

	.web-input-qty {
		width: 50px;
		padding: 3px;
		border: 1px solid #7f9db9;
		font-size: 11px;
		text-align: center;
	}

	.web-btn-action {
		background: linear-gradient(to bottom, #ffcc00 0%, #ff9900 100%);
		border: 1px solid #cc7a00;
		color: #000000;
		font-weight: bold;
		padding: 6px 18px;
		font-size: 12px;
		border-radius: 3px;
		cursor: pointer;
	}

		.web-btn-action:hover {
			background: linear-gradient(to bottom, #ffdb33 0%, #e68a00 100%);
		}

	.web-btn-fav-remove {
		width: 100%;
		background: linear-gradient(to bottom, #ffffff 0%, #e6e6e6 100%);
		border: 1px solid #b5b5b5;
		color: #cc0000;
		font-weight: bold;
		padding: 3px 0;
		font-size: 10px;
		border-radius: 3px;
		cursor: pointer;
	}

	.web-cart-footer {
		margin-top: 15px;
		padding-top: 10px;
		border-top: 1px dotted #ccc;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.web-total-price {
		font-size: 14px;
		font-weight: bold;
		color: #003366;
	}

	.web-actions-bar {
		display: flex;
		gap: 10px;
		align-items: center;
	}
</style>

<div class="web-top-bar">
	<form action="/cart/goback" style="margin: 0;">
		<button type="submit" class="web-btn-default">&laquo; Go Back</button>
	</form>
</div>

@{
	if (!string.Equals((ViewBag.stockChange), ""))
	{
		<div class="web-alert">
			<div style="margin-bottom: 4px;">Quantity of some items in your Cart has been updated according to our stock. These items are:</div>
			<div>@ViewBag.stockChange</div>
		</div>
	}
}

<div class="web-module">
	<div class="web-module-header">
		<span>Cart</span>
	</div>
	<div class="web-module-body">
		<table class="web-table">
			<thead>
				<tr>
					<th>Title</th>
					<th>Price</th>
					<th>Quantity</th>
					<th>Edit Quantity</th>
					<th>Remove Item</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var check in Model)
				{
					<tr>
						<td style="text-align: center; font-weight: bold;"><a href="/ecommerce/details/@check.Id"> @check.Name</a></td>
						<td style="text-align: center;" class="web-price-text">@check.Price</td>
						<td style="text-align: center;">@check.Quantity</td>
						<td style="text-align: center;">
							<form action="/cart/removeone" method="post" style="margin: 0;">
								<input type="hidden" name="id" value="@check.Id" />
								<input type="number" id="quantity" name="quantity" min="1" max="10" step="1" value="@check.Quantity" onkeydown="return false" oninput="this.form.submit()" class="web-input-qty">
							</form>
						</td>
						<td style="text-align: center;">
							<form action="/cart/removeall" method="post" style="margin: 0;">
								<input type="hidden" name="id" value="@check.Id" />
								<button type="submit" class="web-btn-fav-remove">Remove ALL</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>

		<div class="web-cart-footer">
			<div class="web-total-price">
				Total Price: <span class="web-price-text" style="font-size: 16px;">@ViewBag.TotalPrice</span>
			</div>
			<div class="web-actions-bar">
				<form action="/cart/clearbasket" method="post" style="margin: 0;">
					<button type="submit" class="web-btn-default">Clear the Basket</button>
				</form>
				<form action="/cart/gopay" style="margin: 0;">
					<button type="submit" class="web-btn-action">Go to Payment</button>
				</form>
			</div>
		</div>
	</div>
</div>