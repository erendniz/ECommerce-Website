@model List<API.Models.Book>

<style>
	body {
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		background-color: #f8f8f8;
		color: #333333;
		margin: 0;
		padding: 10px 20px;
	}

	a {
		color: #0000cc;
		text-decoration: underline;
	}

		a:hover {
			color: #3366cc;
		}

	.web-top-bar {
		background: linear-gradient(to bottom, #ffffff 0%, #eef0f2 100%);
		border: 1px solid #cccccc;
		border-radius: 4px;
		padding: 8px 15px;
		margin-bottom: 15px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.web-btn-default {
		background: linear-gradient(to bottom, #fefefe 0%, #e0e0e0 100%);
		border: 1px solid #a0a0a0;
		border-radius: 3px;
		padding: 4px 12px;
		font-size: 11px;
		font-weight: bold;
		color: #333;
		cursor: pointer;
		box-shadow: inset 0 1px 0 #fff;
	}

		.web-btn-default:hover {
			background: linear-gradient(to bottom, #f0f0f0 0%, #d0d0d0 100%);
		}

	.web-module {
		border: 1px solid #c8c8c8;
		background-color: #ffffff;
		margin-bottom: 20px;
	}

	.web-module-header {
		background: linear-gradient(to bottom, #e8edf6 0%, #d2dceb 100%);
		border-bottom: 1px solid #b2c2d6;
		padding: 8px 12px;
		font-weight: bold;
		font-size: 14px;
		color: #003366;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.web-module-body {
		padding: 10px;
	}

	.web-table {
		width: 100%;
		border-collapse: collapse;
		background-color: #ffffff;
		border: 1px solid #cccccc;
	}

		.web-table th {
			background: linear-gradient(to bottom, #e8edf6 0%, #d2dceb 100%);
			border: 1px solid #b2c2d6;
			padding: 8px 5px;
			font-size: 11px;
			color: #003366;
			text-align: center;
		}

		.web-table td {
			border: 1px solid #e0e0e0;
			padding: 8px 5px;
			vertical-align: middle;
		}

		.web-table tr:nth-child(even) {
			background-color: #f9f9f9;
		}

		.web-table tr:hover {
			background-color: #f0f4f9;
		}

	.web-price-text {
		font-size: 13px;
		font-weight: bold;
		color: #b20000;
	}

	.web-btn-action {
		width: 100%;
		background: linear-gradient(to bottom, #ffcc00 0%, #ff9900 100%);
		border: 1px solid #cc7a00;
		color: #000000;
		font-weight: bold;
		padding: 4px 0;
		font-size: 11px;
		border-radius: 3px;
		cursor: pointer;
	}

		.web-btn-action:hover {
			background: linear-gradient(to bottom, #ffdb33 0%, #e68a00 100%);
		}

	.web-btn-disabled {
		width: 100%;
		background: #e0e0e0;
		border: 1px solid #cccccc;
		color: #888888;
		padding: 4px 0;
		font-size: 11px;
		border-radius: 3px;
	}

	.web-btn-fav-remove {
		width: 100%;
		background: linear-gradient(to bottom, #ffffff 0%, #e6e6e6 100%);
		border: 1px solid #b5b5b5;
		color: #cc0000;
		font-weight: bold;
		padding: 3px 0;
		font-size: 10px;
		border-radius: 3px;
		cursor: pointer;
	}

	.web-actions-bar {
		margin-top: 15px;
		display: flex;
		gap: 10px;
		align-items: center;
	}

	.web-alert {
		background-color: #fff6bf;
		border: 1px solid #ffd23f;
		padding: 8px 12px;
		margin-bottom: 12px;
		font-weight: bold;
		color: #514721;
	}
</style>

@if (ViewBag.Message != null)
{
	<div class="web-alert">
		@ViewBag.Message
	</div>
}

<div class="web-top-bar">
	<form action="/user/profile" style="margin: 0;">
		<button type="submit" class="web-btn-default">&laquo; Go Back</button>
	</form>
</div>

<div class="web-module">
	<div class="web-module-header">
		<span>My Favorite Items</span>
	</div>
	<div class="web-module-body">
		<table class="web-table">
			<thead>
				<tr>
					<th>Photo</th>
					<th>Title</th>
					<th>Publisher</th>
					<th>Print Year</th>
					<th>Author</th>
					<th>Rating</th>
					<th>Price</th>
					<th>Cart Action</th>
					<th>Favorite Action</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td style="text-align: center;">
							<img src="@item.Image" width="80" height="80" style="object-fit: contain;" />
						</td>
						<td style="text-align: center; font-weight: bold;">@item.Title</td>
						<td style="text-align: center;">@item.Publisher</td>
						<td style="text-align: center;">@item.Printyear</td>
						<td style="text-align: center;">@item.Author</td>
						<td style="text-align: center; font-weight: bold; color: #cc6600;">@item.Rating</td>
						<td style="text-align: center;" class="web-price-text">@item.Price</td>
						<td style="text-align: center;">
							@{
								if (item.Stock > 0)
								{
									<form action="/ecommerce/addbasket" method="post">
										@Html.AntiForgeryToken()
										<input type="hidden" name="id" value="@item.Id" />
										<input type="hidden" name="frompage" value="favorite" />
										<button type="submit" class="web-btn-action">Add to Basket</button>
									</form>
								}
								else
								{
									<button type="submit" class="web-btn-disabled" disabled>Out of Stock...</button>
								}
							}
						</td>
						<td style="text-align: center;">
							<form action="/ecommerce/removefavorites" method="post">
								@Html.AntiForgeryToken()
								<input type="hidden" name="id" value="@item.Id" />
								<input type="hidden" name="frompage" value="favorite" />
								<button type="submit" class="web-btn-fav-remove">- Remove Favorite</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>

		<div class="web-actions-bar">
			<form action="/ecommerce/favoritesbasket" method="post" style="margin: 0;">
				<button type="submit" class="web-btn-action" style="padding: 6px 15px;">Add Everything to Cart</button>
			</form>
		</div>
	</div>
</div>